<?xml version="1.0" encoding="utf-8"?>
<!-- Expressive press feedback: tappable surfaces sink slightly and spring back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="120" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX" android:valueTo="0.96" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY" android:valueTo="0.96" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="320" android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="320" android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
